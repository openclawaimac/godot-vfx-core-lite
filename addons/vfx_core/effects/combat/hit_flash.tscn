[node name="HitFlash" type="Node2D" unique_id=608010994]
script = ExtResource("1_req2w")
effect_id = &"hit_flash"
description = "Hit flash for sprites: the target sprite flashes pure white (added on top, so its detail stays) for a frame or two, then eases back in about 0.2 s; rapid hits keep the glow instead of strobing. Use VfxCore.apply(&\"hit_flash\", sprite); presets damage (red), heal (green) and light_bg (dark red-orange with an outline, for bright scenes)."
